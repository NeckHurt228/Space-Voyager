# raw footage and generated reports stay local
clips/*
!clips/.gitkeep
reports/*
!reports/.gitkeep
!reports/history.csv
__pycache__/
# competitor videos stay local; the measured text results are shared
references/*
!references/README.md
!references/STYLE_PROFILE.md
!references/STYLE_PROFILE.json
!references/_study/
# per-channel folders: keep the notes and ID lists, not the videos
!references/*/
references/*/*.mp4
references/*/*.webm
references/*/*.mkv
references/*/.downloaded.txt
references/_study/**/*.jpg
